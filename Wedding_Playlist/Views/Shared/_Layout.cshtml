<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wedding_Playlist</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Wedding_Playlist.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3" style="background-color: #FBFEFB;">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Wedding Playlist</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Swagger" asp-action="Index">API</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="EventPage" asp-action="ListEvent">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="SongPage" asp-action="Index">Songs</a>
                        </li>   
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="GuestPage" asp-action="Index">Guests</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="PlaylistPage" asp-action="ListPlaylist">Playlists</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="GuestSongRequestPage" asp-action="Index">Song Requests</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    @if (ViewBag.ShowDashboard == true)
    {
        <!-- Dashboard Section -->
        <div class="dashboard-container" style="background-color: #efe5dc; padding: 20px 0; margin-bottom: 20px;">
            <div class="container">
                <div class="row">
                    <div class="col-12 mb-3">
                        <h2 class="text-center" style="color: #b08b6f;">Wedding Dashboard</h2>
                    </div>
                </div>
                <div class="row">
                    <!-- Guests Card -->
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="custom-card h-100">
                            <h5 style="color: #b08b6f;"><i class="bi bi-people-fill me-2"></i>Guests</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Bride's Side:</span>
                                <span>@(ViewBag.BrideSideGuests ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Groom's Side:</span>
                                <span>@(ViewBag.GroomSideGuests ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Both Sides:</span>
                                <span>@(ViewBag.BothSideGuests ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between font-weight-bold" style="border-top: 1px solid #d9b497; padding-top: 8px; margin-top: 8px;">
                                <span>Total:</span>
                                <span>@(ViewBag.TotalGuests ?? 0)</span>
                            </div>
                            <div class="mt-3">
                                <a class="btn btn-sm btn-primary w-100" asp-controller="GuestPage" asp-action="Index">Manage Guests</a>
                            </div>
                        </div>
                    </div>

                    <!-- RSVP Card -->
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="custom-card h-100">
                            <h5 style="color: #b08b6f;"><i class="bi bi-envelope-check-fill me-2"></i>RSVPs</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Attending:</span>
                                <span>@(ViewBag.AcceptedRSVPs ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Not Attending:</span>
                                <span>@(ViewBag.DeclinedRSVPs ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Pending:</span>
                                <span>@(ViewBag.PendingRSVPs ?? 0)</span>
                            </div>
                            <div class="progress mt-2" style="height: 10px;">
                                <div class="progress-bar" role="progressbar" style="width: @(ViewBag.RSVPPercentage ?? 0)%; background-color: #d9b497;" 
                                    aria-valuenow="@(ViewBag.RSVPPercentage ?? 0)" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <small class="d-block text-center mt-1">@(ViewBag.RSVPPercentage ?? 0)% responded</small>
                        </div>
                    </div>

                    <!-- Songs Card -->
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="custom-card h-100">
                            <h5 style="color: #b08b6f;"><i class="bi bi-music-note-list me-2"></i>Songs</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Total Songs:</span>
                                <span>@(ViewBag.TotalSongs ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Guest Requests:</span>
                                <span>@(ViewBag.SongRequests ?? 0)</span>
                            </div>
                            <div class="mt-2">
                                <div class="d-flex justify-content-between text-center">
                                    <small><span class="badge badge-approved">@(ViewBag.ApprovedSongs ?? 0)</span><br>Approved</small>
                                    <small><span class="badge badge-pending">@(ViewBag.PendingSongs ?? 0)</span><br>Pending</small>
                                    <small><span class="badge badge-rejected">@(ViewBag.RejectedSongs ?? 0)</span><br>Rejected</small>
                                </div>
                            </div>
                            <div class="mt-3">
                                <a class="btn btn-sm btn-primary w-100" asp-controller="GuestSongRequestPage" asp-action="Index">View Requests</a>
                            </div>
                        </div>
                    </div>

                    <!-- Events Card -->
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="custom-card h-100">
                            <h5 style="color: #b08b6f;"><i class="bi bi-calendar-event me-2"></i>Upcoming Events</h5>
                            <div class="mb-2">
                                @if (ViewBag.UpcomingEvents != null && ViewBag.UpcomingEvents.Count > 0)
                                {
                                    <ul class="list-unstyled" style="max-height: 150px; overflow-y: auto;">
                                        @foreach (var evt in ViewBag.UpcomingEvents)
                                        {
                                            <li class="mb-1">@evt.Name - @evt.Date.ToString("MM/dd/yyyy")</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p>No upcoming events</p>
                                }
                            </div>
                            <div class="mt-3">
                                <a class="btn btn-sm btn-primary w-100" asp-controller="EventPage" asp-action="ListEvent">View All Events</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="background-color: #FBFEFB;">
        <div class="container">
            &copy; 2025 - Wedding Playlist
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
